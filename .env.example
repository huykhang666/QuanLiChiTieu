# Lấy 3 giá trị này trong Supabase Dashboard > Project Settings > API & Database

# Connection string Postgres (dùng cho Prisma) — Project Settings > Database > Connection string (URI, chọn "Transaction pooler" cho serverless)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
